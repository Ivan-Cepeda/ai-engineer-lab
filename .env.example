# ---------------------------------------------------------------------------
# Copia este archivo a ".env" y completa la clave del proveedor que uses.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / macOS)
#
# El .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Proveedor por defecto: "openai" o "gemini".
LLM_PROVIDER=gemini

# --- OpenAI -----------------------------------------------------------------
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini (tiene capa gratuita) ------------------------------------
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
